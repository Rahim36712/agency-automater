{
  "manifest_version": 3,
  "name": "Agency Mail Tracker",
  "version": "1.0.0",
  "description": "Optional Gmail tracking and a private dashboard for possible opening signals.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Agency Mail Tracker", "default_popup": "popup.html"},
  "options_page": "dashboard.html",
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "content_scripts": [{"matches":["https://mail.google.com/*"],"js":["compose.js","content.js"],"css":["compose.css"],"run_at":"document_idle"}],
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; base-uri 'none';"}
}

# Copy with npm run setup. Never paste secrets into chat or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Automatic availability fallback only moves lower: 3.8 Flash -> 3.5 Flash-Lite -> 3.1 Flash-Lite.
# Confirm Free tier in AI Studio; the application cannot inspect your billing status.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MIN_INTERVAL_MS=15000
GEMINI_DAILY_LIMIT=20
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEET_ID=
SENDER_NAME=
SENDER_EMAIL=
SENDER_BUSINESS_NAME=
SENDER_POSTAL_ADDRESS=
# Comma-separated services you can deliver. Only these can be offered.
DELIVERABLE_SERVICES=Python automation,Web applications,SQL reporting,Data engineering,Cloud and DevOps,AI business automation
# Safe default: drafts may ONLY target these email accounts you control.
OUTREACH_MODE=test
TEST_RECIPIENTS=
MAX_LEADS_PER_RUN=3
MAX_DRAFTS_PER_RUN=3
TIMEZONE=Asia/Karachi
HELPER_PORT=8787
HELPER_TOKEN=
N8N_PORT=5678
# Optional email-opening signals. Run npm run tracking:setup for a private admin key.
TRACKING_ENABLED=false
TRACKING_URL=
TRACKING_ADMIN_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_CONFIRMED=false
TRACKING_WORKER_NAME=agency-mail-tracker
